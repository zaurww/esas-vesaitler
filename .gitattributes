# Data files are part of the storage contract (CLAUDE.md §4, §11):
# UTF-8 without BOM, LF. Keep git from rewriting line endings on Windows.
*.tsv  text eol=lf
*.toml text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.xlsx binary

# Everything else that is plain source, not just the storage-contract files
# above -- without these, core.autocrlf on a Windows checkout flags them as
# modified on every clone even though no byte of content changed (caught
# because `git diff` showed nothing for them, only a CRLF/LF warning).
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# .bat files are stored with CRLF, byte for byte (-text: no conversion in
# either direction, so GitHub's release zip carries CRLF too). They used to
# be committed with bare LF, and cmd.exe misparses LF-only batch files:
# on a user's machine Başlat.bat printed "'cho' is not recognized" -- the
# line offsets drifted after "chcp 65001". CLAUDE.md §9.
*.bat -text
# .ps1 left as committed: PowerShell reads LF fine.

# Not shipped in release zips (GitHub's zipball_url / "Download ZIP"
# honour export-ignore) — meaningless without a .git checkout anyway.
.gitattributes export-ignore
.gitignore     export-ignore
